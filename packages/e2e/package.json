{
  "name": "@the-rfp-hub/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end suite for the RFP Hub: an external runner that boots a disposable Postgres, the API on a restricted role, the frontend and a fixture web server, then drives Playwright against real HTTP and a real browser.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "e2e": "tsx src/run.ts",
    "e2e:compliance": "tsx src/run.ts --compliance",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/pg": "^8.11.10",
    "dotenv": "^17.4.2",
    "jose": "^6.2.8",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/The-RFP-Hub/the-rfp-hub",
    "directory": "packages/e2e"
  }
}
