{
  "name": "@the-rfp-hub/mcp",
  "version": "0.0.0",
  "description": "Model Context Protocol server for the RFP Hub — search and submit Ethereum-ecosystem funding opportunities from an MCP client.",
  "license": "MIT",
  "type": "module",
  "mcpName": "io.github.the-rfp-hub/rfp-hub",
  "bin": {
    "rfphub-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "server.json", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm -w build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@the-rfp-hub/standard": "workspace:*",
    "rfphub-validate": "workspace:*",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "keywords": ["rfp-hub", "mcp", "model-context-protocol", "funding", "grants", "ethereum"],
  "repository": {
    "type": "git",
    "url": "https://github.com/The-RFP-Hub/the-rfp-hub",
    "directory": "packages/mcp"
  }
}
