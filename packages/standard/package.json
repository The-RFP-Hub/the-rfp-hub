{
  "name": "@the-rfp-hub/standard",
  "version": "3.1.0",
  "description": "RFP Hub Standard — canonical JSON Schema + generated TypeScript types for Ethereum-ecosystem funding opportunities.",
  "license": "CC0-1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schemas/*": "./schemas/*",
    "./registries/*": "./registries/*",
    "./conformance/*": "./conformance/*",
    "./meta/*": "./meta/*",
    "./ns/*": "./ns/*",
    "./spec.config.json": "./spec.config.json"
  },
  "files": [
    "dist",
    "schemas",
    "registries",
    "conformance",
    "meta",
    "ns",
    "spec.config.json",
    "CHANGELOG.md",
    "NORMATIVE.md",
    "PROCESS.md",
    "ARTIFACTS.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "codegen": "node scripts/codegen.mjs",
    "codegen:check": "node scripts/codegen.mjs --check",
    "check": "node scripts/check-spec.mjs",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm -w build"
  },
  "keywords": ["rfp-hub", "funding", "grants", "json-schema", "ethereum", "standard"],
  "repository": {
    "type": "git",
    "url": "https://github.com/The-RFP-Hub/the-rfp-hub",
    "directory": "packages/standard"
  }
}
