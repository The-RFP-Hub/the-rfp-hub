{
  "name": "@the-rfp-hub/api",
  "version": "0.0.2",
  "private": true,
  "description": "RFP Hub public /v1/ REST API (Fastify + Postgres) serving the RFP Hub Standard.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:create": "tsx scripts/create-db.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "export": "tsx scripts/export.ts",
    "jobs": "tsx scripts/jobs/run-job.ts",
    "export:api": "tsx scripts/export-from-api.ts",
    "corpus:fetch": "tsx tools/converter/fetch-corpus.ts",
    "corpus:convert": "tsx tools/converter/convert.ts",
    "dedupe:threshold": "tsx scripts/dedupe-threshold-report.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@the-rfp-hub/standard": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.8.5",
    "jose": "^6.2.8",
    "pg": "^8.13.1",
    "rfphub-validate": "workspace:*",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/The-RFP-Hub/the-rfp-hub",
    "directory": "packages/api"
  }
}
