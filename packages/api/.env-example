# RFP Hub /v1/ API — local environment (M2)
# Copy to .env and adjust. Matches packages/api/docker-compose.yml defaults.

# Postgres connection string
DATABASE_URL=postgres://rfphub:rfphub@localhost:5432/rfphub

# HTTP server
PORT=3001
HOST=0.0.0.0
# Max size of the pg pool (default 10). Bound it on a shared database instance.
DB_POOL_MAX=10

# Origin the OpenAPI document advertises as servers[0].url. Leave UNSET locally: the default is the
# relative "/", which is correct wherever the server happens to be reachable. A deployed
# environment sets it to the API's OWN origin — never the apex, which is the specification's
# origin — and https is required for any host that is not loopback, because this value tells every
# client which scheme to speak:
#   PUBLIC_BASE_URL=https://api.example.org
# PUBLIC_BASE_URL=

# That is the whole server config. The seed loader is NOT configured here: it takes a corpus file
# as its argument (`pnpm seed <path-to-corpus.json>`) and reads no environment pointer at all.
#
# Refreshing that corpus is a separate program, run by hand, and the only thing that talks to an
# upstream: SOURCE_API_URL (plus optional SOURCE_BRAND / CORPUS_SIZE) is read by
# scripts/fetch-corpus.ts straight from the environment. Export it in your shell for that one
# command — it is deliberately not listed as a deployment variable, and no value for it is ever
# committed. See README.md, "Seeding: fetch → file → seed".
