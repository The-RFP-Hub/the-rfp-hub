# RFP Hub /v1/ API — local environment
#
# Copy this to `packages/api/.env`: `src/config.ts` loads it with dotenv from the working
# directory, which for every pnpm script here is `packages/api`. A REAL environment variable always
# wins — dotenv never overwrites something already in the process — so an exported shell variable
# and a deployment's injected value both override the file. With neither, the built-in defaults
# apply and say so on stderr.
#
#   cp .env-example .env
#   pnpm --filter @the-rfp-hub/api migrate
#
# LOCAL ONLY. `.env` is gitignored, excluded from the Docker build context, and nothing copies it
# into an image: a deployment gets these values from its ECS task definition instead — the secret
# ones through `secrets:`, the rest through `environment:`. See packages/api/docs/deploy.md, which
# also carries the rotation runbook for values that were baked into earlier images.
#
# The values below match packages/api/docker-compose.yml.

# Postgres connection string
DATABASE_URL=postgres://rfphub:rfphub@localhost:5432/rfphub

# HTTP server
PORT=3001
HOST=0.0.0.0
# Max size of the pg pool (default 10). Bound it on a shared database instance.
DB_POOL_MAX=10

# Origin the OpenAPI document advertises as servers[0].url. Leave UNSET locally: the default is the
# relative "/", which is correct wherever the server happens to be reachable. A deployed
# environment sets it to the API's OWN origin — never the apex, which is the specification's
# origin — and https is required for any host that is not loopback, because this value tells every
# client which scheme to speak. The apex reservation (adr/0007) reads the same value to tell a
# caller refused on the spec's apex hostname where the API actually is; left at the default it just
# says "a different host" rather than guessing one:
#   PUBLIC_BASE_URL=https://api.example.org
# PUBLIC_BASE_URL=

# What sits in front of this process, for X-Forwarded-For purposes. NOT a boolean: `true` is
# rejected at boot. `X-Forwarded-For` is client-supplied, so blanket trust would let any caller
# choose the address that ends up in the analytics hash. A hop count, or a list of proxy
# addresses/CIDRs. Unset (the default) trusts nothing, which is right locally.
#   TRUST_PROXY=1
#   TRUST_PROXY=10.0.0.0/8,192.168.0.0/16
# TRUST_PROXY=

# ── Authentication (M3) ──────────────────────────────────────────────────────────────
# The dashboard sends `Authorization: Bearer <access token>`; the API verifies it locally with the
# app's PEM verification key — ES256, expected issuer, `aud` = the app id. Use a SEPARATE identity
# application per environment (development / staging / production), so a token minted for one
# cannot authenticate against another and the user records stay isolated.
#
# The app id is not secret (the browser has it); the verification key is treated as one, because
# swapping it swaps who can log in.
#   PRIVY_APP_ID=
#   PRIVY_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\n…\n-----END PUBLIC KEY-----"
#
# `\n` written as two characters is fine — config.ts restores the newlines, which is what makes a
# one-line secret store usable for a multi-line PEM.
#
# OPTIONAL and UNVERIFIED: no JWKS endpoint is documented for app access tokens, so this is an
# override to use only if you have confirmed one exists for your app. The PEM above is the
# documented mechanism.
#   PRIVY_JWKS_URL=
#
# OPTIONAL server-side secret. Used ONLY by account enrichment (filling in wallet/email after
# login), which is queued and never on the authentication path — a request never waits on it and an
# outage never locks anyone out. Without it, enrichment is inert.
#   PRIVY_APP_SECRET=
#
# There is NO admin list here, on purpose: a role granted by the environment is granted on every
# login, to whoever holds the deployment configuration, and cannot be revoked in the product. The
# first admin is made once, by an operator with the migration credential:
#   pnpm --filter @the-rfp-hub/api grant-admin -- --did did:privy:... --create --yes
# Every admin after that is made by an admin, over POST /v1/admin/accounts/:id/role.

# ── Duplicate detection (M3) ─────────────────────────────────────────────────────────
# `openai` (needs OPENAI_API_KEY), `deterministic` (a hashed token bag — no credential, used by
# CI so the dedupe tests are not gated on a key), or `disabled`. The default is `openai` when a key
# is present and `disabled` when it is not: falling back to `deterministic` silently would leave a
# deployment reporting duplicate checks it is not really performing.
# EMBEDDING_PROVIDER=deterministic
# OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_TIMEOUT_MS=5000
# Cosine similarity at or above which a pair is recorded as suspected. PER PROVIDER — the same
# number means different things in different embedding spaces — so the default follows the provider
# (openai 0.86, deterministic 0.72). Both are provisional pending the threshold sweep.
# DEDUPE_SIMILARITY_THRESHOLD=
# DEDUPE_MAX_MATCHES=5

# ── Verification-assist (M3) ─────────────────────────────────────────────────────────
# Fetches `applicationUrl` and diffs the page against the submission. A low-bar anti-spam signal,
# never a fact-check.
# VERIFICATION_ENABLED=true
# VERIFY_ON_SUBMIT=true                  # default: on, except under NODE_ENV=test
# VERIFY_TIMEOUT_MS=10000
# VERIFY_MAX_BYTES=2097152               # 2 MiB, streamed
# VERIFY_QUEUE_MAX=100                   # full → skip the submit-time trigger; the cron still picks it up
#
# DANGEROUS, AND REFUSED IN PRODUCTION. Turns off the address checks that stop the fetcher reaching
# loopback, private and link-local addresses — including the instance metadata endpoint. It exists
# for one loopback end-to-end test; with NODE_ENV=production the process refuses to start rather
# than serve with the guard off.
# VERIFY_ALLOW_PRIVATE_HOSTS=false
#
# Optional egress proxy. The network-layer backstop: application-level address validation should
# not be the only thing standing between a submitted URL and your internal network.
# VERIFIER_EGRESS_PROXY=

# ── Publisher analytics (M3) ─────────────────────────────────────────────────────────
# ANALYTICS_ENABLED=true
# Keys the session/IP HMAC. A SECRET, injected at runtime and never baked into an image: a leaked
# key concatenated into a plain digest would make the whole IPv4 space brute-forceable against the
# stored hashes. Unset → a random per-boot key: the hashes stay unlinkable, but session
# de-duplication resets on every restart. The UTC date is part of the HMAC input, so the effective
# key rotates daily and hashes cannot be joined across days.
# ANALYTICS_HMAC_KEY=
# ANALYTICS_RETENTION_DAYS=180

# ── Staleness (M3) ───────────────────────────────────────────────────────────────────
# Days without a publisher touch after which an open entry that has NO future fixed deadline is
# auto-closed as inactive. Any publisher write, granted claim or successful verification resets the
# clock. An entry with a known future deadline is never closed by this rule.
# STALENESS_INACTIVE_DAYS=90

# ── Open-data export (pnpm export) ───────────────────────────────────────────────────
# Minimum live entries required to publish. A run below this floor writes NOTHING and exits
# non-zero, so a broken seed cannot replace latest.json/latest.csv with an empty dataset. It
# applies to both sources.
EXPORT_MIN_COUNT=100

# The API-sourced export (`pnpm export:api`) publishes a LIVE deployment rather than the database,
# so it needs no DATABASE_URL at all. EXPORT_API_URL is required by that command and read by
# nothing else: the bare ORIGIN of the API to publish, with no path. https is mandatory for any
# host that is not loopback — this value decides what gets published, so plaintext would let the
# network path choose the dataset.
#   EXPORT_API_URL=https://api.example.org
# Where it writes its six files (default: exports).
#   EXPORT_OUT_DIR=exports

# That is the whole server config. The seed loader is NOT configured here: it takes a corpus file
# as its argument (`pnpm seed data/seed-corpus.json`) and reads no environment pointer at all
# (`SEED_STRICT=1` only mirrors the `--strict` flag). That
# corpus is a committed repo artifact — RFP Hub Standard documents, curated and reviewed in-tree.
#
# Rebuilding it in bulk from an upstream registry is offline maintainer tooling, run by hand, and
# the only thing here that talks to a network: SOURCE_API_URL (plus optional SOURCE_BRAND /
# CORPUS_SIZE) is read by tools/converter/fetch-corpus.ts straight from the environment. Export it
# in your shell for that one command — it is deliberately not a deployment variable, and no value
# for it is ever committed. See README.md, "Seeding: a static, in-repo corpus".
