{
  "name": "@the-rfp-hub/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "RFP Hub — open standard, validation tooling, API, client, and agent libraries for Ethereum-ecosystem funding opportunities.",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "codegen": "pnpm -r --if-present codegen",
    "codegen:check": "pnpm -r --if-present codegen:check",
    "check": "pnpm -r --if-present check",
    "check:neutral": "node scripts/check-neutral.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "check:m2": "node scripts/check-m2.mjs",
    "check:m3": "node scripts/check-m3.mjs",
    "e2e": "pnpm --filter @the-rfp-hub/e2e e2e",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": ">=0.28.1",
      "vite>esbuild": ">=0.28.1"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.10",
    "@types/node": "^22.10.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^15.0.3",
    "rfphub-validate": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
